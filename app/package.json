{
  "name": "@pile/app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "preact": "11.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
